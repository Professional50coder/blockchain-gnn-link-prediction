# Copy to .env and fill in. Never commit the filled-in file.

# Etherscan API key — powers balance and transaction lookups in the
# Live Blockchain Explorer. Free key: https://etherscan.io/myapikey
# Without one, Etherscan's stricter anonymous rate limit applies.
ETHERSCAN_API_KEY=

# Ethereum mainnet JSON-RPC endpoint — powers eth_getLogs event decoding.
# Any Alchemy / Infura / QuickNode mainnet URL works.
# Defaults to a rate-limited public endpoint if unset.
WEB3_PROVIDER_URL=
